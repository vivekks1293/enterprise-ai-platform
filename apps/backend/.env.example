# ==========================================
# OmniDoc Platform Backend Environment Configuration
# ==========================================

APP_NAME=OmniDoc
APP_VERSION=1.0.0
ENVIRONMENT=development

# ==========================================
# Authentication & Security (JWT)
# ==========================================
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ==========================================
# Database Configuration (PostgreSQL 16)
# ==========================================
# Async URL for FastAPI runtime (asyncpg)
# Use 'postgres' hostname when running inside Docker, or 'localhost' when running bare-metal
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai

# Sync/Psycopg URL for Alembic migrations
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enterprise_ai

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ==========================================
# Large Language Model Provider (OpenAI / Compatible)
# ==========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# ==========================================
# Observability & LLMOps (Langfuse v4)
# ==========================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_CAPTURE_CONTENT=false

OTEL_CONSOLE_EXPORTER=false
OTEL_SAMPLING_RATIO=1.0

